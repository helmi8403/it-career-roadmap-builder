rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // Profiles are written with strictly limited self-service fields.
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','photoURL','email','createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL']);
      allow delete: if false;
    }

    match /users/{uid}/progress/{chapterId} {
      allow read, delete: if owner(uid) || admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['chapterId','completed','lastStudiedAt','updatedAt']);
    }

    // Attempts are student-owned drafts only. Never treat a client-submitted score as authoritative.
    match /users/{uid}/attempts/{attemptId} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['questionId','selected','submittedAt','contentVersion']);
      allow update, delete: if false;
    }

    // Published lessons can be read by signed-in users; only a trusted admin can edit.
    match /lessons/{lessonId} {
      allow read: if signedIn() && resource.data.published == true || admin();
      allow write: if admin();
    }

    // Do not publish answer keys to the browser; grading requires trusted backend logic.
    match /answerKeys/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
